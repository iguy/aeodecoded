---
import Base from '../layouts/Base.astro';
import { SITE, PLATFORMS, THEME_SONG } from '../config.js';

const description =
  'Gary Crossey is the host of AEO Decoded and founder of Irishguy Design Studio in Asheville, NC. He builds and tests the Answer Engine Optimization methods the show teaches.';

const person = {
  '@type': 'Person',
  '@id': new URL('/about/#gary-crossey', SITE.url).href,
  name: 'Gary Crossey',
  url: new URL('/about/', SITE.url).href,
  jobTitle: 'Founder, Irishguy Design Studio',
  worksFor: {
    '@type': 'Organization',
    name: SITE.studioName,
    url: SITE.studioUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: '45 S French Broad Ave, Suite 170',
      addressLocality: 'Asheville',
      addressRegion: 'NC',
      postalCode: '28801',
      addressCountry: 'US',
    },
  },
  email: 'mailto:garycrossey@irishguy.us',
  knowsAbout: [
    'Answer Engine Optimization',
    'Structured data and schema markup',
    'Web architecture and edge deployment',
    'Brand and web design',
  ],
};

const themeSong = {
  '@type': 'MusicRecording',
  '@id': new URL('/about/#theme-song', SITE.url).href,
  name: THEME_SONG.name,
  url: THEME_SONG.url,
  sameAs: [THEME_SONG.url],
  duration: THEME_SONG.duration,
  byArtist: { '@type': 'MusicGroup', name: THEME_SONG.artist },
  about: { '@type': 'PodcastSeries', name: SITE.title, url: SITE.url },
  description: `The theme song of the ${SITE.title} podcast.`,
  recordingOf: {
    '@type': 'MusicComposition',
    name: THEME_SONG.name,
    lyrics: {
      '@type': 'CreativeWork',
      text: THEME_SONG.lyrics.map((s) => s.lines.join('\n')).join('\n\n'),
    },
  },
};

const schema = { '@context': 'https://schema.org', '@graph': [person, themeSong] };
---

<Base title="About Gary Crossey" description={description} schema={schema} currentPath="/about/">
  <article class="prose">
    <header class="episode-head">
      <p class="field field--blue">Host // Entity record</p>
      <h1>Gary Crossey</h1>
      <p class="citable">
        <mark>Gary Crossey is the host of AEO Decoded and founder of Irishguy Design
        Studio in Asheville, North Carolina — he builds, tests, and proves the
        Answer Engine Optimization methods the show teaches.</mark>
      </p>
    </header>

    <h2>About the host</h2>
    <p>
      Gary makes Answer Engine Optimization make sense. With a Belfast accent and a
      designer's eye, he translates the technical mechanics of AI search — schema,
      entities, structure, speed — into plain language and short, tactical episodes.
    </p>
    <p>
      He's not a commentator. Gary is the founder of
      <a href={SITE.studioUrl} rel="noopener">{SITE.studioName}</a> in Asheville,
      North Carolina, where he designs and engineers the sites these methods get
      tested on — for clients, and for the studio itself. AEO Decoded is an Irishguy
      project: this site was rebuilt from WordPress to a custom edge architecture as
      the show's own public test bench.
    </p>

    <h2>About the show</h2>
    <p>
      AEO Decoded breaks down how websites earn citations from AI answer engines
      like ChatGPT, Perplexity, and Gemini. Seasons 1 and 2 cover the fundamentals
      in depth. Season 3, now live, is a build log: real changes to real sites, measured in
      public. The editorial rule is simple — every episode is a principle or a
      tested result. Nothing else ships.
    </p>

    <h2 id="theme-song">The AEO Decoded theme song</h2>
    <p>
      The AEO Decoded podcast has its own theme song, "{THEME_SONG.name}," on Spotify.
    </p>
    <div class="spotify-facade" data-spotify-id={THEME_SONG.spotifyId}>
      <button type="button" class="button spotify-load">
        Play "{THEME_SONG.name}" on Spotify
      </button>
      <p class="spotify-note">
        Loads the Spotify player. Or <a href={THEME_SONG.url} rel="noopener">open "{THEME_SONG.name}" in Spotify</a>.
      </p>
    </div>
    <details class="lyrics">
      <summary>Lyrics to "{THEME_SONG.name}"</summary>
      {THEME_SONG.lyrics.map((sec) => (
        <div class="lyrics-section">
          <p class="field">{sec.label}</p>
          <p>{sec.lines.map((line, i) => (<>{line}{i < sec.lines.length - 1 && <br />}</>))}</p>
        </div>
      ))}
      <p class="spotify-note">The chorus and bridge are instrumental.</p>
    </details>
    <script>
      document.querySelectorAll('.spotify-facade').forEach((box) => {
        box.querySelector('.spotify-load')?.addEventListener('click', () => {
          const id = box.getAttribute('data-spotify-id');
          const frame = document.createElement('iframe');
          frame.src = `https://open.spotify.com/embed/track/${id}?autoplay=1`;
          frame.title = 'AEO Decoded theme song on Spotify';
          frame.width = '100%';
          frame.height = '152';
          frame.style.border = '0';
          frame.style.borderRadius = '12px';
          frame.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
          box.replaceChildren(frame);
        });
      });
    </script>

    <h2>Get in touch</h2>
    <p>
      Questions, topic suggestions, or AEO war stories:
      <a href="mailto:garycrossey@irishguy.us">garycrossey@irishguy.us</a>.
      Listener questions get featured in Q&amp;A lightning rounds.
    </p>

    <ul class="platforms" aria-label="Listen on your favorite platform">
      {PLATFORMS.map((p) => (
        <li><a href={p.url} rel="noopener">{p.name}</a></li>
      ))}
    </ul>
  </article>
</Base>
