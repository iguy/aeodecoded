---
import Base from '../../layouts/Base.astro';
import EpisodeLedger from '../../components/EpisodeLedger.astro';
import { getSeasons } from '../../lib/episodes.js';
import { SITE } from '../../config.js';

const seasons = await getSeasons();
const count = seasons.reduce((n, s) => n + s.episodes.length, 0);
---

<Base
  title="Episodes"
  description={`Every episode of ${SITE.title}: ${count} episodes on Answer Engine Optimization across Seasons 1, 2, and 3.`}
  currentPath="/episodes/"
>
  <section class="hero">
    <p class="field field--blue">Archive // {count} episodes</p>
    <h1>Episodes</h1>
    <p class="citable">
      <mark>Seasons 1 and 2 cover the fundamentals of Answer Engine Optimization in
      depth — from schema and entity clarity to trust signals and measurement.
      Season 3 puts those fundamentals to work on real sites: principles and
      tested results, measured in public.</mark>
    </p>
  </section>

  {seasons.map((s) => (
    <section class="season-block">
      <span class="field">{s.label} // {s.episodes.length} episodes</span>
      <EpisodeLedger episodes={s.episodes} />
    </section>
  ))}

  <section class="cta-strip">
    <p class="field">Season 3</p>
    <h2>Season 3 is live — with receipts.</h2>
    <p>
      Season 3 holds every episode to one standard: a principle or a tested result,
      measured on real sites, including the AEO Decoded site itself.
    </p>
    <a class="button" href="/the-reset/">Why AEO Decoded reset Season 3</a>
  </section>
</Base>
