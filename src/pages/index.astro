---
import Base from '../layouts/Base.astro';
import EpisodeLedger from '../components/EpisodeLedger.astro';
import { getShow } from '../lib/episodes.js';
import { SITE, PLATFORMS } from '../config.js';

const show = await getShow();
const latest = show.episodes.slice(0, 6);
const s3Latest = show.episodes.find((ep) => ep.season === 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: SITE.title,
  description: SITE.description,
  url: SITE.url,
  image: show.image ?? undefined,
  webFeed: 'https://feeds.transistor.fm/aeo-decoded',
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.studioName, url: SITE.studioUrl },
  sameAs: PLATFORMS.map((p) => p.url),
};
---

<Base schema={schema} currentPath="/">
  <section class="hero">
    <p class="field field--blue kicker">Podcast // {SITE.tagline}</p>
    <h1>Getting cited is the new getting found.</h1>
    <p class="citable">
      <mark>{SITE.title} is a podcast that documents, tests, and proves how websites
      earn citations from AI answer engines like ChatGPT, Perplexity, and Gemini.</mark>
    </p>
    <ul class="platforms" id="listen" aria-label="Listen on your favorite platform">
      {PLATFORMS.map((p) => (
        <li><a href={p.url} rel="noopener">{p.name}</a></li>
      ))}
    </ul>
  </section>

  <aside class="reset-banner">
    <p class="field">Now playing // Season 3</p>
    <h2>Season 3 is live.</h2>
    <p>
      Season 3 runs on one editorial standard: nothing ships unless it's a principle
      or a tested result. The AEO Decoded site, rebuilt from WordPress to the edge,
      is the test bench.
    </p>
    {s3Latest && (
      <a class="go" href={`/episodes/${s3Latest.slug}/`}>Listen to the latest Season 3 episode: {s3Latest.title} →</a>
    )}
    <p><a href="/the-reset/">Why AEO Decoded paused Season 3 and rebuilt the site →</a></p>
  </aside>

  <section class="season-block">
    <span class="field">Latest episodes</span>
    <EpisodeLedger episodes={latest} />
    <p style="margin-top:1rem;">
      <a href="/episodes/">All episodes, Seasons 1–3 →</a>
    </p>
  </section>

  <section class="cta-strip">
    <p class="field">The method, applied</p>
    <h2>This site is the case study.</h2>
    <p>
      AEO Decoded is a project of Irishguy Design Studio. Everything the show teaches —
      answer-first structure, entity clarity, schema, edge performance — is running on
      this page right now. The studio builds the same system for clients.
    </p>
    <a class="button" href={SITE.studioUrl} rel="noopener">Work with Irishguy</a>
  </section>
</Base>
